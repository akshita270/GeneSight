# OpenAI
OPENAI_API_KEY=sk-...

# NCBI Entrez (https://www.ncbi.nlm.nih.gov/account/)
ENTREZ_EMAIL=your@email.com
ENTREZ_API_KEY=your_ncbi_api_key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Pipeline tuning (optional)
PUBMED_MAX_RESULTS=20
HYPOTHESIS_MAX=5

# Vercel frontend origin (set this on Render after deploying frontend)
# e.g. https://genomics-ai.vercel.app
FRONTEND_ORIGIN=
