# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── NCBI Entrez (free at https://www.ncbi.nlm.nih.gov/account/) ──────────────
ENTREZ_EMAIL=your@email.com
ENTREZ_API_KEY=your_ncbi_api_key

# ── Neo4j AuraDB (https://console.neo4j.io) ──────────────────────────────────
# For Docker Compose local setup, these are overridden automatically
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your_aura_password

# ── Neon PostgreSQL (https://neon.tech) — optional, enables auth & history ───
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Clerk Auth (https://clerk.com) — optional, enables user auth ──────────────
CLERK_SECRET_KEY=sk_test_...

# ── Pipeline tuning ───────────────────────────────────────────────────────────
PUBMED_MAX_RESULTS=30
HYPOTHESIS_MAX=5
FREE_QUERIES_PER_DAY=3
